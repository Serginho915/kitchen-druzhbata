# Copy this file to .env. The frontend uses same-origin /api and needs no public API URL.

# Server-side OpenRouter configuration for weekly recipe generation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=SofiaFood
